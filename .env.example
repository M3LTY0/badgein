# Copy to .env (it is git-ignored) and fill in what you need.

# --- Public setting (safe to be visible: it is baked into the website) ---
# The address badge QR codes point at. Set this to your live site so badges made on localhost still work on other phones.
# Optional: leave blank and the QR uses whatever address the app is running on.
# On Vercel, add it under Project > Settings > Environment Variables, then redeploy.
VITE_PUBLIC_URL=

# --- Secrets (only the optional resume API server reads these; never put them in a VITE_ variable) ---
ANTHROPIC_API_KEY=
# Optional: cheaper/faster is fine for extraction.
# RESUME_MODEL=claude-haiku-5-5
